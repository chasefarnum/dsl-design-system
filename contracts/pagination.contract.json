{
  "id": "pagination",
  "name": "Pagination",
  "description": "Prev/next arrow buttons with numbered page items, active state, ellipsis, and disabled states. Supports sm and md sizes.",
  "source": "components/pagination/pagination.html",
  "cssClass": "dsl-pagination",
  "props": {
    "size": { "options": ["sm", "md"], "default": "md" }
  },
  "states": ["default", "active", "hover", "disabled"],
  "nested": ["button"],
  "composition": {
    "slots": {
      "default": {
        "childOrder": ["prev", "pages", "next"],
        "children": {
          "prev":  { "figma": { "booleanProp": "showPrev", "sizing": "fixed", "width": 36, "height": 36 } },
          "pages": { "figma": { "textProp": "currentPage" } },
          "next":  { "figma": { "booleanProp": "showNext", "sizing": "fixed", "width": 36, "height": 36, "position": "trailing" } }
        }
      }
    }
  },
  "tokens": {
    "color": {
      "background.default":  "color.bg.default",
      "background.active":   "button.primary.bg",
      "background.hover":    "color.bg.subtle",
      "text.default":        "color.text.primary",
      "text.active":         "color.text.inverse",
      "text.disabled":       "color.text.muted",
      "border.default":      "color.border.default"
    },
    "spacing": {
      "size.md":      "spacing.5",
      "size.sm":      "spacing.4",
      "gap":          "spacing.1"
    },
    "typography": {
      "page.family":  "typography.font-family.body",
      "page.size.md": "typography.font-size.sm",
      "page.size.sm": "typography.font-size.xs",
      "page.weight":  "typography.font-weight.semibold"
    },
    "border": {
      "radius": "shape.radius.md",
      "width":  "shape.border-width.thin"
    }
  },
  "a11y": {
    "role": "navigation",
    "aria": ["aria-label", "aria-current", "aria-disabled"],
    "keyboard": ["Tab", "Enter", "Space"]
  },
  "platforms": ["web"]
}
