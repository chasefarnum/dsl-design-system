{
  "name": "icons",
  "description": "SVG icon system using Phosphor Icons Bold weight (phosphoricons.com) — MIT license. 256×256 viewBox, rendered via Phosphor web components.",
  "primitive": "native",
  "cssClass": "dsl-icon",
  "source": "components/icons/icons.html",
  "variants": {
    "size": {
      "options": [16, 20, 24, 32],
      "default": 20,
      "cssModifier": "dsl-icon--{size}"
    }
  },
  "icons": [
    "arrow-right","arrow-left","chevron-down","chevron-up","chevron-right","chevron-left",
    "close","check","search","menu","external-link","phone","email",
    "star","user","calendar","info","warning","error","success"
  ],
  "tokens": {
    "--color-text-primary": "var(--color-text-primary)",
    "--color-text-muted": "var(--color-text-muted)"
  }
}
