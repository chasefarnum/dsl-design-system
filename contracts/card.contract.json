{
  "id": "card",
  "name": "Card",
  "description": "Surface container for community highlights, resident profiles, and CTA blocks. Supports flat, raised, bordered, and clickable variants. Includes horizontal layout.",
  "source": "components/card/card.html",
  "cssClass": "dsl-card",
  "props": {
    "elevation": { "options": ["flat", "raised", "bordered"], "default": "flat" },
    "layout":    { "options": ["vertical", "horizontal"],     "default": "vertical" }
  },
  "states": ["default", "hover"],
  "nested": ["button", "badge"],
  "composition": {
    "slots": {
      "default": {
        "childOrder": ["media", "header", "body", "footer"],
        "children": {
          "media":    { "figma": { "booleanProp": "showMedia",  "sizing": "fixed", "width": 560, "height": 280 } },
          "header":   { "figma": { "booleanProp": "showHeader" } },
          "body":     { "figma": { "textProp": "bodyText" } },
          "footer":   { "figma": { "booleanProp": "showFooter", "position": "trailing" } }
        }
      }
    }
  },
  "tokens": {
    "color": {
      "background.default":  "color.bg.default",
      "border.default":      "color.border.default",
      "text.primary":        "color.text.primary",
      "text.secondary":      "color.text.secondary",
      "text.muted":          "color.text.muted"
    },
    "spacing": {
      "padding.x":  "spacing.5",
      "padding.y":  "spacing.5",
      "gap.inner":  "spacing.4"
    },
    "typography": {
      "title.family":    "typography.font-family.body",
      "title.size":      "typography.font-size.xl",
      "title.weight":    "typography.font-weight.bold",
      "subtitle.family": "typography.font-family.body",
      "subtitle.size":   "typography.font-size.sm",
      "subtitle.weight": "typography.font-weight.regular",
      "body.family":     "typography.font-family.body",
      "body.size":       "typography.font-size.md",
      "body.weight":     "typography.font-weight.regular"
    },
    "border": {
      "radius": "shape.radius.lg",
      "width":  "shape.border-width.thin"
    },
    "motion": {
      "shadow.default": "shape.shadow.sm",
      "shadow.raised":  "shape.shadow.md"
    }
  },
  "a11y": {
    "role": "article",
    "aria": ["aria-label", "aria-labelledby"],
    "keyboard": ["Enter"]
  },
  "platforms": ["web"]
}
