{
  "id": "badge",
  "name": "Badge",
  "description": "Compact inline label for status, category tags, and availability callouts on community pages.",
  "source": "components/badge/badge.html",
  "cssClass": "dsl-badge",
  "props": {
    "intent": { "options": ["default", "brand", "success", "warning", "error", "info"], "default": "default" },
    "size":   { "options": ["sm", "md"], "default": "md" }
  },
  "states": ["default", "hover", "dismissed"],
  "nested": [],
  "composition": {
    "slots": {
      "default": {
        "childOrder": ["label", "dismiss"],
        "children": {
          "label":   { "figma": { "textProp": "label" } },
          "dismiss": { "figma": { "booleanProp": "dismissible", "sizing": "fixed", "width": 14, "height": 14, "position": "trailing" } }
        }
      }
    }
  },
  "tokens": {
    "color": {
      "background.default":  "color.bg.subtle",
      "background.brand":    "color.bg.brand",
      "background.success":  "color.bg.subtle",
      "background.warning":  "color.bg.subtle",
      "background.error":    "color.bg.subtle",
      "background.info":     "color.bg.subtle",
      "text.default":        "color.text.secondary",
      "text.brand":          "color.text.inverse",
      "border.default":      "color.border.default"
    },
    "spacing": {
      "padding.x.md": "spacing.3",
      "padding.y.md": "spacing.1",
      "padding.x.sm": "spacing.2",
      "padding.y.sm": "spacing.1",
      "gap":          "spacing.2"
    },
    "typography": {
      "label.family":        "typography.font-family.body",
      "label.size.md":       "typography.font-size.sm",
      "label.size.sm":       "typography.font-size.xs",
      "label.weight":        "typography.font-weight.semibold",
      "label.letterSpacing": "typography.letter-spacing.wide"
    },
    "border": {
      "radius": "shape.radius.full",
      "width":  "shape.border-width.thin"
    }
  },
  "a11y": {
    "role": "status",
    "aria": ["aria-label"],
    "keyboard": []
  },
  "platforms": ["web"]
}
