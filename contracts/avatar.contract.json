{
  "id": "avatar",
  "name": "Avatar",
  "description": "User representation via image, initials, or icon. Supports online status badge and avatar groups.",
  "source": "components/avatar/avatar.html",
  "cssClass": "dsl-avatar",
  "props": {
    "type": { "options": ["image", "initials", "icon"], "default": "image" },
    "size": { "options": ["xs", "sm", "md", "lg", "xl"],  "default": "md" }
  },
  "states": ["default", "with-badge"],
  "nested": [],
  "composition": {
    "slots": {
      "default": {
        "childOrder": ["content", "badge"],
        "children": {
          "content": { "figma": { "textProp": "initials", "visibleWhen": "type=initials" } },
          "badge":   { "figma": { "booleanProp": "showBadge", "sizing": "fixed", "width": 12, "height": 12, "position": "trailing" } }
        }
      }
    }
  },
  "tokens": {
    "color": {
      "background.brand":   "color.bg.brand",
      "background.subtle":  "color.bg.subtle",
      "text.inverse":       "color.text.inverse",
      "text.muted":         "color.text.muted",
      "border.default":     "color.border.default",
      "badge.online":       "button.primary.bg"
    },
    "spacing": {
      "size.xs": "spacing.4",
      "size.sm": "spacing.5",
      "size.md": "spacing.6",
      "size.lg": "spacing.7",
      "size.xl": "spacing.8"
    },
    "typography": {
      "initials.family": "typography.font-family.body",
      "initials.weight": "typography.font-weight.semibold",
      "initials.size.xs": "typography.font-size.xs",
      "initials.size.md": "typography.font-size.sm",
      "initials.size.lg": "typography.font-size.md"
    },
    "border": {
      "radius": "shape.radius.full",
      "width":  "shape.border-width.thin"
    }
  },
  "a11y": {
    "role": "img",
    "aria": ["aria-label"],
    "keyboard": []
  },
  "platforms": ["web"]
}
