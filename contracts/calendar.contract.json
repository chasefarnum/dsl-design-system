{
  "id": "calendar",
  "name": "Calendar",
  "description": "Month-view date picker with prev/next navigation, day grid, and date selection states.",
  "source": "components/calendar/calendar.html",
  "cssClass": "dsl-calendar",
  "props": {
    "variant": { "options": ["default"], "default": "default" }
  },
  "states": ["default", "today", "selected", "disabled", "hover", "focus"],
  "nested": [],
  "composition": {
    "slots": {
      "default": {
        "childOrder": ["header", "weekdays", "grid"],
        "children": {
          "header":   { "figma": { "textProp": "monthLabel" } },
          "weekdays": { "figma": { "booleanProp": "showWeekdays" } },
          "grid":     { "figma": { "booleanProp": "showGrid" } }
        }
      }
    }
  },
  "tokens": {
    "color": {
      "background.default":   "color.bg.default",
      "background.subtle":    "color.bg.subtle",
      "background.selected":  "button.primary.bg",
      "background.today":     "color.bg.subtle",
      "text.primary":         "color.text.primary",
      "text.muted":           "color.text.muted",
      "text.inverse":         "color.text.inverse",
      "border.default":       "color.border.default",
      "focus.ring":           "color.border.focus"
    },
    "spacing": {
      "padding.x":     "spacing.4",
      "padding.y":     "spacing.4",
      "cell.padding":  "spacing.2",
      "gap":           "spacing.2"
    },
    "typography": {
      "title.family":  "typography.font-family.body",
      "title.size":    "typography.font-size.md",
      "title.weight":  "typography.font-weight.semibold",
      "day.family":    "typography.font-family.body",
      "day.size":      "typography.font-size.sm",
      "day.weight":    "typography.font-weight.regular"
    },
    "border": {
      "radius.cell":   "shape.radius.full",
      "radius.panel":  "shape.radius.md",
      "width":         "shape.border-width.thin"
    }
  },
  "a11y": {
    "role": "application",
    "aria": ["aria-label", "aria-live", "aria-pressed", "aria-disabled"],
    "keyboard": ["ArrowLeft", "ArrowRight", "ArrowUp", "ArrowDown", "Enter", "Space", "PageUp", "PageDown"]
  },
  "platforms": ["web"]
}
