{
  "id": "button",
  "name": "Button",
  "description": "Primary interactive element for CTAs and form submissions. Used across all HubSpot landing page modules.",
  "source": "components/button/button.html",
  "cssClass": "dsl-btn",
  "props": {
    "variant": { "options": ["primary", "secondary", "ghost"], "default": "primary" },
    "size":    { "options": ["sm", "md", "lg"], "default": "md" }
  },
  "states": ["default", "hover", "focus", "active", "disabled", "loading"],
  "nested": ["icon"],
  "composition": {
    "slots": {
      "default": {
        "childOrder": ["icon-left", "label", "icon-right", "spinner"],
        "children": {
          "icon-left":  { "figma": { "booleanProp": "iconLeft",  "sizing": "fixed", "width": 20, "height": 20 } },
          "label":      { "figma": { "textProp": "label" } },
          "icon-right": { "figma": { "booleanProp": "iconRight", "sizing": "fixed", "width": 20, "height": 20, "position": "trailing" } },
          "spinner":    { "figma": { "booleanProp": "loading",   "sizing": "fixed", "width": 20, "height": 20, "visibleWhen": "state=loading" } }
        }
      }
    }
  },
  "tokens": {
    "color": {
      "background.primary":          "button.primary.bg",
      "background.primary.hover":    "button.primary.bg-hover",
      "text.primary":                "button.primary.text",
      "border.primary":              "button.primary.border",
      "background.secondary":        "button.secondary.bg",
      "background.secondary.hover":  "button.secondary.bg-hover",
      "text.secondary":              "button.secondary.text",
      "border.secondary":            "button.secondary.border",
      "background.ghost":            "button.ghost.bg",
      "background.ghost.hover":      "button.ghost.bg-hover",
      "text.ghost":                  "button.ghost.text",
      "border.ghost":                "button.ghost.border",
      "focus.ring":                  "color.border.focus"
    },
    "spacing": {
      "padding.x.sm": "spacing.3",
      "padding.y.sm": "spacing.2",
      "padding.x.md": "spacing.4",
      "padding.y.md": "spacing.3",
      "padding.x.lg": "spacing.5",
      "padding.y.lg": "spacing.4",
      "gap":          "spacing.2"
    },
    "typography": {
      "label.family":   "typography.font-family.body",
      "label.size.sm":  "typography.font-size.sm",
      "label.size.md":  "typography.font-size.md",
      "label.size.lg":  "typography.font-size.lg",
      "label.weight":   "typography.font-weight.semibold"
    },
    "border": {
      "radius": "shape.radius.md",
      "width":  "shape.border-width.thin"
    },
    "motion": {
      "transition": "motion.duration.fast"
    }
  },
  "a11y": {
    "role": "button",
    "aria": ["aria-busy", "aria-disabled", "aria-label"],
    "keyboard": ["Enter", "Space"]
  },
  "platforms": ["web"]
}
