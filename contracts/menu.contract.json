{
  "id": "menu",
  "name": "Menu",
  "description": "Dropdown menu with a trigger button and panel of items. Supports basic items, icon items, links, dividers, and destructive items. Aligns left or right.",
  "source": "components/menu/menu.html",
  "cssClass": "dsl-menu",
  "props": {
    "align": { "options": ["left", "right"], "default": "left" }
  },
  "states": ["closed", "open"],
  "nested": ["button", "icons"],
  "composition": {
    "slots": {
      "default": {
        "childOrder": ["trigger", "panel"],
        "children": {
          "trigger": { "figma": { "booleanProp": "showTrigger" } },
          "panel": {
            "childOrder": ["item"],
            "children": {
              "item": { "figma": { "textProp": "itemLabel", "visibleWhen": "state=open" } }
            }
          }
        }
      }
    }
  },
  "tokens": {
    "color": {
      "background.panel":       "color.bg.default",
      "background.item.hover":  "color.bg.subtle",
      "text.item":              "color.text.primary",
      "text.destructive":       "color.text.secondary",
      "border.default":         "color.border.default",
      "border.divider":         "color.border.subtle"
    },
    "spacing": {
      "padding.item.x":  "spacing.4",
      "padding.item.y":  "spacing.3",
      "padding.panel.y": "spacing.2",
      "gap.icon":        "spacing.3",
      "min.width":       "spacing.8"
    },
    "typography": {
      "item.family":  "typography.font-family.body",
      "item.size":    "typography.font-size.md",
      "item.weight":  "typography.font-weight.regular"
    },
    "border": {
      "radius": "shape.radius.md",
      "width":  "shape.border-width.thin"
    },
    "motion": {
      "shadow": "shape.shadow.lg"
    }
  },
  "a11y": {
    "role": "menu",
    "aria": ["aria-haspopup", "aria-expanded", "aria-controls", "aria-labelledby"],
    "keyboard": ["Enter", "Space", "Escape", "ArrowDown", "ArrowUp", "Home", "End"]
  },
  "platforms": ["web"]
}
