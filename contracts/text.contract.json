{
  "id": "text",
  "name": "Text",
  "description": "Full typography system: headings h1–h6 (Montserrat Bold), body variants (lg/md/sm/xs), eyebrow label, caption, blockquote (brand left border), inline code, and link styles.",
  "source": "components/text/text.html",
  "cssClass": "dsl-text",
  "props": {
    "variant": {
      "options": ["h1", "h2", "h3", "h4", "h5", "h6", "body-lg", "body", "body-sm", "body-xs", "eyebrow", "caption", "blockquote", "code", "link"],
      "default": "body"
    }
  },
  "states": ["default"],
  "nested": [],
  "composition": {
    "slots": {
      "default": {
        "childOrder": ["text"],
        "children": {
          "text": { "figma": { "textProp": "content" } }
        }
      }
    }
  },
  "tokens": {
    "color": {
      "heading":         "color.text.primary",
      "body":            "color.text.primary",
      "body.muted":      "color.text.muted",
