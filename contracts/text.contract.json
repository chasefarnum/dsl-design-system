      "caption":         "color.text.muted",
      "blockquote.text": "color.text.primary",
      "blockquote.border": "color.text.brand",
      "link":            "color.text.link",
      "link.hover":      "color.text.link-hover",
      "code.text":       "color.text.brand",
      "code.background": "color.bg.subtle"
    },
    "spacing": {
      "blockquote.padding.x": "spacing.5",
      "blockquote.border.width": "spacing.1"
    },
    "typography": {
