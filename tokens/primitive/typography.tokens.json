{
  "typography": {
    "font-family": {
      "heading": { "value": "Montserrat, sans-serif", "$type": "fontFamily" },
      "body":    { "value": "Montserrat, sans-serif", "$type": "fontFamily" }
    },
    "font-size": {
      "xs":  { "value": 12, "$type": "dimension" },
      "sm":  { "value": 14, "$type": "dimension" },
      "md":  { "value": 16, "$type": "dimension" },
      "lg":  { "value": 18, "$type": "dimension" },
      "xl":  { "value": 24, "$type": "dimension" },
      "2xl": { "value": 32, "$type": "dimension" },
      "3xl": { "value": 40, "$type": "dimension" },
      "4xl": { "value": 56, "$type": "dimension" },
      "5xl": { "value": 72, "$type": "dimension" }
    },
    "font-weight": {
      "regular":  { "value": 400, "$type": "number" },
      "medium":   { "value": 500, "$type": "number" },
      "semibold": { "value": 600, "$type": "number" },
      "bold":     { "value": 700, "$type": "number" }
    },
    "line-height": {
      "tight":   { "value": 1.1,  "$type": "number" },
      "snug":    { "value": 1.25, "$type": "number" },
      "normal":  { "value": 1.5,  "$type": "number" },
      "relaxed": { "value": 1.75, "$type": "number" }
    },
    "letter-spacing": {
      "tight":  { "value": "-0.02em", "$type": "string" },
      "normal": { "value": "0em",     "$type": "string" },
      "wide":   { "value": "0.05em",  "$type": "string" },
      "wider":  { "value": "0.1em",   "$type": "string" }
    }
  }
}
