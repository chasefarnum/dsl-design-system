{
  "shape": {
    "radius": {
      "none": { "$value": 0,    "$type": "dimension" },
      "sm":   { "$value": 4,    "$type": "dimension" },
      "md":   { "$value": 8,    "$type": "dimension" },
      "lg":   { "$value": 16,   "$type": "dimension" },
      "xl":   { "$value": 24,   "$type": "dimension" },
      "full": { "$value": 9999, "$type": "dimension" }
    },
    "border-width": {
      "thin":   { "$value": 1, "$type": "dimension" },
      "medium": { "$value": 2, "$type": "dimension" },
      "thick":  { "$value": 3, "$type": "dimension" }
    },
    "shadow": {
      "xs": { "$value": "0 1px 2px rgba(0,0,0,0.06)",   "$type": "shadow" },
      "sm": { "$value": "0 2px 8px rgba(0,0,0,0.08)",   "$type": "shadow" },
      "md": { "$value": "0 4px 16px rgba(0,0,0,0.12)",  "$type": "shadow" },
      "lg": { "$value": "0 8px 32px rgba(0,0,0,0.16)",  "$type": "shadow" },
      "xl": { "$value": "0 16px 48px rgba(0,0,0,0.20)", "$type": "shadow" }
    }
  }
}
